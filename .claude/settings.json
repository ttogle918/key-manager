{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)",
      "Read(./**/*.db)",
      "Read(./**/service-account*.json)",
      "Read(./**/credentials*.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ],
    "allow": [
      "Bash(pip-licenses:*)",
      "Bash(reuse lint)",
      "Bash(npx license-checker:*)",
      "Bash(pytest:*)"
    ]
  }
}
