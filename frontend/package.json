{
  "name": "frontend",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "vendor:ocr": "node scripts/vendor-tesseract.mjs",
    "fixtures:ocr": "node --experimental-strip-types scripts/ocr-demo-fixtures.mts",
    "predev": "node scripts/vendor-tesseract.mjs && node scripts/vendor-fonts.mjs",
    "prebuild": "node scripts/vendor-tesseract.mjs && node scripts/vendor-fonts.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
