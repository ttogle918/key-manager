# 이 파일은 .env의 레퍼런스용 템플릿입니다. 실제 값은 .env에 채우고, .env는 절대 커밋하지 마세요.
# ⚠️ 코드가 실제로 읽는 변수만 기재합니다 — 읽지 않는 변수를 문서화하면
#    설정해도 조용히 무시되어 잘못된 안전감을 줍니다. (SECURITY_REVIEW 1-3)

# --- 프론트엔드 (Vite) ---
# 백엔드 주소 재정의. 기본값: http://localhost:8003 (frontend/src/api/client.ts)
VITE_API_BASE=http://localhost:8003

# --- SYNC-2: 계정 로그인 기반 서버 동기화(Supabase, 옵트인) ---
# 실제 값은 frontend/.env.local 에 넣는다(Vite는 패키지 루트 .env*만 읽음, 이 루트 .env 아님).
# anon(public) key는 Supabase 설계상 클라이언트 노출 전제 — RLS로 접근 제어(service_role 키는 절대 미사용).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 백엔드 (VAULT-1/2, 구현 완료) ---
# 암호화 금고 SQLite 경로(암호문만 저장). 기본값: backend/vault.db (backend/app/main.py)
KEYLENS_VAULT_PATH=./backend/vault.db

# 잠금 정책 (미설정 시 기본값 사용 — backend/app/vault_session.py)
# 무활동 자동 잠금까지의 시간(초). 기본 300
KEYLENS_AUTOLOCK_SECONDS=300
# 지연 없이 허용되는 연속 실패 횟수. 기본 2 (이후부터 지수 백오프)
KEYLENS_AUTH_FREE_ATTEMPTS=2
# 실패 지연 상한(초). 기본 30
KEYLENS_AUTH_MAX_DELAY_SECONDS=30

# --- 앱 환경 ---
APP_ENV=

# --- 백엔드 (FastAPI) ---
BACKEND_HOST=
BACKEND_PORT=

# --- 프론트엔드 (React) ---
FRONTEND_PORT=
VITE_API_BASE_URL=

# --- 저장소 (SQLite, 암호문만 저장) ---
DATABASE_PATH=

# --- OCR 엔진 (tesseract 또는 paddleocr) ---
OCR_ENGINE=
TESSERACT_CMD_PATH=

# --- 보안 / 인증 (마스터 비밀번호 자체는 .env에 저장하지 않음) ---
SESSION_TIMEOUT_MINUTES=
MAX_AUTH_ATTEMPTS=
AUTH_LOCKOUT_SECONDS=

# --- 로깅 ---
LOG_LEVEL=


host=
port=
database=
DB_USERNAME=
DB_URL=
DB_PASSWORD=