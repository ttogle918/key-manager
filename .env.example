# 이 파일은 .env의 레퍼런스용 템플릿입니다. 실제 값은 .env에 채우고, .env는 절대 커밋하지 마세요.
# ⚠️ 코드가 실제로 읽는 변수만 기재합니다 — 읽지 않는 변수를 문서화하면
#    설정해도 조용히 무시되어 잘못된 안전감을 줍니다. (SECURITY_REVIEW 1-3)
#
# ⚠️ 백엔드(FastAPI)와 `node scripts/dev.mjs`는 .env 파일을 자동으로 읽지 않습니다
#    (python-dotenv 미사용, dev.mjs는 현재 셸 환경변수를 그대로 물려줄 뿐입니다).
#    아래 OLLAMA_*·KEYLENS_* 변수는 .env에 값만 채워 넣는 것으로는 백엔드에 전달되지 않고,
#    반드시 실제 셸 환경변수로 export한 뒤 `node scripts/dev.mjs`를 실행해야 적용됩니다.
#      - Windows(cmd):        set OLLAMA_MODEL=llama3.2 && node scripts/dev.mjs
#      - Windows(PowerShell): $env:OLLAMA_MODEL="llama3.2"; node scripts/dev.mjs
#      - macOS/Linux:         OLLAMA_MODEL=llama3.2 node scripts/dev.mjs
#    여러 변수를 한 번에 적용하려면(Git Bash/macOS/Linux) manager-relay와 동일한 방식으로
#    .env를 셸에 직접 로드한 뒤 실행하세요: set -a && source .env && set +a && node scripts/dev.mjs

# --- 프론트엔드 (Vite) ---
# 백엔드 주소 재정의. 기본값: http://localhost:8003 (frontend/src/api/client.ts)
VITE_API_BASE=http://localhost:8003

# --- SYNC-2(재설계): 이메일 릴레이 동기화(계정/DB 없음, 옵트인) ---
# manager-relay/ 를 직접 배포한 뒤 그 공개 주소를 넣는다(비밀 아님 — 자격증명은
# manager-relay 자신의 배포 환경에만 있음). 비워두면 "이메일로 내보내기" 버튼이 안 보인다.
VITE_SYNC_RELAY_URL=

# --- 화면 설명 기능(EXPLAIN, 1단계 — 로컬 Ollama, 옵트인) ---
# OLLAMA_MODEL이 없으면 "이 화면 설명해줘" 기능 자체가 비활성화된다(기본 모델을 추측하지 않음).
# 앱은 어떤 모델도 번들하지 않는다 — 이미 설치·실행 중인 Ollama에만 연결한다.
# ⚠️ 이 파일(.env)에 값만 채워서는 백엔드에 반영되지 않는다 — 위쪽 안내대로 셸 환경변수로
#    export한 뒤 `node scripts/dev.mjs`를 실행해야 한다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Tavily 검색(옵트인) — 미설정 시 화면 설명은 검색 없이 기존대로 동작(등급만 ai_unverified로 낮아짐).
# 도메인 제한 없음(설계 판단 A). https://tavily.com 에서 발급.
TAVILY_API_KEY=
# 로컬 발견 캐시 경로 재정의(선택). 기본값: backend/local_discoveries.yaml
KEYLENS_LOCAL_DISCOVERIES_PATH=

# --- 백엔드 (VAULT-1/2, 구현 완료) ---
# 암호화 금고 SQLite 경로(암호문만 저장). 기본값: backend/vault.db (backend/app/main.py)
# ⚠️ 이 변수도 위 OLLAMA_* 와 동일한 제약이 있다 — .env에 적는 것만으로는 적용되지 않는다.
KEYLENS_VAULT_PATH=./backend/vault.db

# 잠금 정책 (미설정 시 기본값 사용 — backend/app/vault_session.py)
# 무활동 자동 잠금까지의 시간(초). 기본 300
KEYLENS_AUTOLOCK_SECONDS=300
# 지연 없이 허용되는 연속 실패 횟수. 기본 2 (이후부터 지수 백오프)
KEYLENS_AUTH_FREE_ATTEMPTS=2
# 실패 지연 상한(초). 기본 30
KEYLENS_AUTH_MAX_DELAY_SECONDS=30

ANON_PUBLIC=

# --- 매니저 릴레이(SYNC-2, 이메일 내보내기) ---
# 릴레이는 별도 배포 서비스라 정식 설정은 manager-relay/.env.example 을 보세요.
# 여기 두는 건 레포 루트에서 릴레이를 로컬로 띄워 볼 때뿐입니다.
# Gmail 이면 2단계 인증 계정에서 발급한 16자리 "앱 비밀번호"가 필요합니다(로그인 비밀번호 아님).
# ⚠️ 발송 계정의 "보낸 편지함"에 릴레이 이력이 계속 쌓입니다 - 개인 메일 대신 전용 계정을
#    쓰거나 발송 전용 서비스를 권합니다(manager-relay/README.md 참고).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=
