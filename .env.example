# 이 파일은 .env의 레퍼런스용 템플릿입니다. 실제 값은 .env에 채우고, .env는 절대 커밋하지 마세요.

# --- 앱 환경 ---
APP_ENV=development

# --- 백엔드 (FastAPI) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- 프론트엔드 (React) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- 저장소 (SQLite, 암호문만 저장) ---
DATABASE_PATH=./data/vault.db

# --- OCR 엔진 (tesseract 또는 paddleocr) ---
OCR_ENGINE=paddleocr
TESSERACT_CMD_PATH=

# --- 보안 / 인증 (마스터 비밀번호 자체는 .env에 저장하지 않음) ---
SESSION_TIMEOUT_MINUTES=15
MAX_AUTH_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=30

# --- 로깅 ---
LOG_LEVEL=info
